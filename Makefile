# automata-lab build system
#
# Usage:
#   make                build all libraries
#   make test           build and run all tests
#   make clean          remove the build directory
#
# Extra flags for both compiling and linking (e.g. sanitizers):
#   make test CFLAGS_EXTRA='-fsanitize=address,undefined -g'

CC           ?= cc
CFLAGS       ?= -O2
CFLAGS_EXTRA ?=

STD      = -std=c11 -D_POSIX_C_SOURCE=200809L
WARNINGS = -Wall -Wextra -Wpedantic -Wshadow -Wstrict-prototypes \
           -Wmissing-prototypes -Wconversion -Wno-sign-conversion
DEPFLAGS = -MMD -MP

ALL_CFLAGS = $(STD) $(WARNINGS) $(CFLAGS) $(CFLAGS_EXTRA) -Iinclude

# ---------------------------------------------------------------------------
# Directories
# ---------------------------------------------------------------------------

BUILD    = build
OBJ_DIR  = $(BUILD)/obj
LIB_DIR  = $(BUILD)/lib
TEST_DIR = $(BUILD)/tests

# ---------------------------------------------------------------------------
# Platform: shared library extension, flags and runtime search path.
# The rpath lets binaries in build/<dir>/ find libraries in build/lib/
# without installing them or setting LD_LIBRARY_PATH.
# ---------------------------------------------------------------------------

UNAME_S ?= $(shell uname -s)

ifeq ($(UNAME_S),Darwin)
  LIB_EXT      = dylib
  SHARED_FLAGS = -dynamiclib -install_name @rpath/$(notdir $@)
  ORIGIN       = @loader_path
else
  # Linux, WSL, other ELF systems
  LIB_EXT      = so
  SHARED_FLAGS = -shared
  ORIGIN       = $$ORIGIN
endif

TEST_RPATH = -Wl,-rpath,'$(ORIGIN)/../lib'

# ---------------------------------------------------------------------------
# Libraries
# ---------------------------------------------------------------------------

CORE_SRCS = src/random.c
CORE_OBJS = $(CORE_SRCS:src/%.c=$(OBJ_DIR)/%.o)
CORE_LIB  = $(LIB_DIR)/libautomata-core.$(LIB_EXT)

# ---------------------------------------------------------------------------
# Tests: every tests/test_*.c becomes build/tests/test_*
# ---------------------------------------------------------------------------

TEST_SRCS = $(wildcard tests/test_*.c)
TEST_BINS = $(TEST_SRCS:tests/%.c=$(TEST_DIR)/%)

# ---------------------------------------------------------------------------
# Targets
# ---------------------------------------------------------------------------

.PHONY: all test clean

all: $(CORE_LIB)

$(OBJ_DIR)/%.o: src/%.c | $(OBJ_DIR)
	$(CC) $(ALL_CFLAGS) $(DEPFLAGS) -fPIC -c $< -o $@

$(CORE_LIB): $(CORE_OBJS) | $(LIB_DIR)
	$(CC) $(SHARED_FLAGS) $(CFLAGS_EXTRA) -o $@ $^

$(TEST_DIR)/%: tests/%.c $(CORE_LIB) | $(TEST_DIR)
	$(CC) $(ALL_CFLAGS) $(DEPFLAGS) -Itests $< -o $@ \
		-L$(LIB_DIR) -lautomata-core $(TEST_RPATH)

test: $(TEST_BINS)
	@status=0; \
	for t in $(TEST_BINS); do \
		./$$t || status=1; \
	done; \
	if [ $$status -eq 0 ]; then echo "All tests passed."; \
	else echo "Some tests FAILED."; fi; \
	exit $$status

$(OBJ_DIR) $(LIB_DIR) $(TEST_DIR):
	mkdir -p $@

clean:
	rm -rf $(BUILD)

# Header dependency files generated by -MMD (missing on first build: ignored)
-include $(CORE_OBJS:.o=.d) $(TEST_BINS:=.d)
